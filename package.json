{
  "name": "wallpaper-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visualise wallpaper/wallcoverings in 2D photo overlay, 3D preview, and live AR.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "mobile": "cd mobile && npx expo start",
    "mobile:install": "cd mobile && npm install"
  },
  "dependencies": {
    "@tensorflow-models/deeplab": "^0.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@tensorflow/tfjs-backend-wasm": "^4.22.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.0.0",
    "three": "^0.171.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "~5.7.0",
    "vite": "^6.3.0"
  }
}
