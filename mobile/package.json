{
  "name": "wallpaper-visualizer-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "postinstall": "node scripts/generate-assets.mjs && node scripts/download-deeplab-tflite.mjs",
    "assets": "node scripts/generate-assets.mjs",
    "start": "expo start --offline",
    "start:localhost": "expo start --localhost",
    "start:lan": "expo start --lan",
    "start:clear": "expo start --offline -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "build:dev": "eas build --profile development --platform android",
    "build:preview": "eas build --profile preview --platform android",
    "build:production": "eas build --profile production --platform all"
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@reactvision/react-viro": "^2.43.4",
    "@shopify/react-native-skia": "2.2.12",
    "@tensorflow-models/deeplab": "^0.2.2",
    "@tensorflow/tfjs": "^4.22.0",
    "@types/react": "~19.1.10",
    "expo": "^54.0.0",
    "expo-asset": "~12.0.13",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-gl": "~16.0.10",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "jpeg-js": "^0.4.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-view-shot": "~4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "three": "^0.175.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/three": "^0.175.0",
    "typescript": "~5.7.0"
  }
}
